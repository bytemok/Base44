{
  "name": "StockCriticoConfig",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "number",
      "description": "ID del producto en Odoo"
    },
    "producto": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "nivel_minimo": {
      "type": "number",
      "default": 0
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "alerta_activa": {
      "type": "boolean",
      "default": false
    },
    "ultima_alerta_stock": {
      "type": "number"
    },
    "ultima_alerta_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "producto",
    "nivel_minimo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}